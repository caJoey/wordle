{
  "name": "themed-wordle-multiplayer",
  "description": "Themed multiplayer Wordle: up to 4 players race to solve words generated from a theme by Gemma.",
  "version": "2.0.0",
  "type": "module",
  "private": "true",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"tsx watch server/index.ts\" \"vite --host\"",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "server": "tsx watch server/index.ts",
    "start": "node scripts/start.mjs",
    "test": "node --import tsx --test \"tests/*.test.ts\" \"server/test/*.test.ts\"",
    "eval": "tsx scripts/eval-themes.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikhaD/wordle.git"
  },
  "keywords": [],
  "author": "MikhaD",
  "bugs": {
    "url": "https://github.com/MikhaD/wordle/issues"
  },
  "homepage": "https://github.com/MikhaD/wordle#readme",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^2.0.2",
    "@tsconfig/svelte": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "sass": "^1.57.1",
    "svelte": "^3.55.0",
    "svelte-check": "^3.0.1",
    "tslib": "^2.4.1",
    "typescript": "^4.9.4",
    "vite": "^4.0.4"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2"
  }
}
